# Configuración de Entorno para Finca La Leonora
# Copia este archivo como .env y coloca la cadena de conexión de tu base de datos Neon

# Puerto local
PORT=8080

# Cadena de conexión de Neon Serverless PostgreSQL (obtenida de la consola de Neon)
# Ejemplo:
# DATABASE_URL=postgres://tu_usuario:tu_contraseña@ep-dry-leaf-123456.us-east-2.aws.neon.tech/neondb?sslmode=require
DATABASE_URL=
